# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXX

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# Stripe Price IDs (create these in your Stripe Dashboard)
VITE_STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
VITE_STRIPE_PRICE_STARTER_YEARLY=price_starter_yearly
VITE_STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
VITE_STRIPE_PRICE_PRO_YEARLY=price_pro_yearly
VITE_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_enterprise_monthly
VITE_STRIPE_PRICE_ENTERPRISE_YEARLY=price_enterprise_yearly
